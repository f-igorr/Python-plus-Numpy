xx.py

# ==========================================
# 🐍 PYTHON ARTIFACTS & CACHES
# ==========================================

# Byte-compiled / optimized files (Standard Python generated files)
*.py[cod]
*~$
__pycache__/
*.egg-info/
dist/
build/

# Virtual environments (Crucial: Never commit the environment itself!)
# Covers standard 'venv' and '.venv' which is common practice.
venv/
.venv/
env/
*/env/ 

# Package installer cache logs
pip-log.txt
pip-delete-this-directory/


# ==========================================
# 💻 VS CODE CONFIGURATION (Local User Settings)
# ==========================================

# Ignore user workspace settings, specific extensions data, and local history.
# We generally commit .vscode/settings.json for project standards, but ignore the rest.
.vscode/*
!.vscode/settings.json # EXCEPTION: Keep general project settings if you want to share them
!.vscode/launch.json # EXCEPTION: Keep debugging configuration if needed


# ==========================================
# 🧪 TESTING & DOCUMENTATION ARTIFACTS
# ==========================================

# Coverage reports
htmlcov/
coverage.pyc

# Test runner caches (e.g., pytest)
.pytest_cache/

# Jupyter Notebook check-points
.ipynb_checkpoints/


# ==========================================
# 🍎 OPERATING SYSTEM FILES
# ==========================================

# macOS specific files
.DS_Store

# Windows temporary/thumbnail files
Thumbs.db
ehthumbs.db

